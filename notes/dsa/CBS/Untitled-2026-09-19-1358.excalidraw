      "seed": 522565734,
      "version": 239,
      "versionNonce": 62684838,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "NjSVi-pHdLY1LzgDQpgSn",
          "type": "arrow"
        }
      ],
      "updated": 1792734393967,
      "created": 1792734274100,
      "link": null,
      "locked": false,
      "text": "main():\n\n    N = input()\n\n    int A[N] // everyone 0\n\n    Q = input()\n    \n    for i = 0; i < Q; i++:\n        L, R, X = input()\n\n        for j = L; j <= R; j++:\n            A[j] += X\n\n\n    for i = 0; i < N; i++:\n        print(A[i])",
      "fontSize": 37,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "main():\n\n    N = input()\n\n    int A[N] // everyone 0\n\n    Q = input()\n    \n    for i = 0; i < Q; i++:\n        L, R, X = input()\n\n        for j = L; j <= R; j++:\n            A[j] += X\n\n\n    for i = 0; i < N; i++:\n        print(A[i])",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
