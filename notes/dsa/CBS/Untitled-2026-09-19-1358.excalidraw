    {
      "id": "WXv8XT-EhWvuUxnzPxaqs",
      "type": "text",
      "x": 10081.47994482688,
      "y": 1476.7534824568718,
      "width": 468.7156982421875,
      "height": 1017.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bTL",
      "roundness": null,
      "seed": 1569348134,
      "version": 497,
      "versionNonce": 1642210682,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792735549173,
      "created": 1792735480149,
      "link": null,
      "locked": false,
      "text": "main():\n\n    N = input()\n\n    int A[N] = input()\n\n    Q = input()\n\n    int diff[N] // initally 0\n    \n    for i = 0; i < Q; i++:\n        L, R, X = input()\n\n        diff[L] += X\n        diff[R + 1] -= X\n\n\n    for i = 1; i < N; i++:\n        diff[i] += diff[i - 1]\n\n    for(i = 0; i < N; i++)\n        print(A[i] + diff[i])",
      "fontSize": 37,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "main():\n\n    N = input()\n\n    int A[N] = input()\n\n    Q = input()\n\n    int diff[N] // initally 0\n    \n    for i = 0; i < Q; i++:\n        L, R, X = input()\n\n        diff[L] += X\n        diff[R + 1] -= X\n\n\n    for i = 1; i < N; i++:\n        diff[i] += diff[i - 1]\n\n    for(i = 0; i < N; i++)\n        print(A[i] + diff[i])",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
