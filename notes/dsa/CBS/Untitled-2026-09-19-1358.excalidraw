    },
    {
      "id": "uT7vHf6Le5AjZWxduAhH2",
      "type": "text",
      "x": 7131.200566752548,
      "y": 1323.2956227416369,
      "width": 465.82977294921875,
      "height": 925,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bSV",
      "roundness": null,
      "seed": 1023421114,
      "version": 388,
      "versionNonce": 382266746,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792734975651,
      "created": 1792734876211,
      "link": null,
      "locked": false,
      "text": "main():\n\n    N = input()\n\n    int A[N] // everyone 0\n\n    Q = input()\n    \n    for i = 0; i < Q; i++:\n        L, R, X = input()\n\n        A[L] += X\n         A[R + 1] -= X\n\n\n    for i = 1; i < N; i++:\n        A[i] += A[i - 1]\n\n    for(i = 0; i < N; i++)\n        print(A[i])",
      "fontSize": 37,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "main():\n\n    N = input()\n\n    int A[N] // everyone 0\n\n    Q = input()\n    \n    for i = 0; i < Q; i++:\n        L, R, X = input()\n\n        A[L] += X\n         A[R + 1] -= X\n\n\n    for i = 1; i < N; i++:\n        A[i] += A[i - 1]\n\n    for(i = 0; i < N; i++)\n        print(A[i])",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
