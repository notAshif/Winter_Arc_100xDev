      "link": null,
      "locked": false,
      "text": "freq = map()\n\nfor(int x : freq):\n    if freq.seen(x):\n        freq[x]++;\n    else:\n        freq[x]--;\nfor key : freq:\n    return key -> freq[key]",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "freq = map()\n\nfor(int x : freq):\n    if freq.seen(x):\n        freq[x]++;\n    else:\n        freq[x]--;\nfor key : freq:\n    return key -> freq[key]",
      "autoResize": true,
      "lineHeight": 1.25
    },
