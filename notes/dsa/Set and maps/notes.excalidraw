      "text": "freq = empty_map()\nfor x : freq:\n    if freq.contain(x):\n        freq[x]+=1\n    else:\n        freq[x] -=1\n    \nfor key : freq:\n    print(key \"->\" freq[key])",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "freq = empty_map()\nfor x : freq:\n    if freq.contain(x):\n        freq[x]+=1\n    else:\n        freq[x] -=1\n    \nfor key : freq:\n    print(key \"->\" freq[key])",
      "autoResize": true,
      "lineHeight": 1.25
    },
