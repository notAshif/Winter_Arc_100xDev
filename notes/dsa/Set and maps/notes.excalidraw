      "text": "Frequ count\nfor i = 0; i < n-1 i++:\n    for i = i+1 j < n-1 j++:\n        if a[i] == a[j]:\n            count++;\n    return count;",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Frequ count\nfor i = 0; i < n-1 i++:\n    for i = i+1 j < n-1 j++:\n        if a[i] == a[j]:\n            count++;\n    return count;",
      "autoResize": true,
      "lineHeight": 1.25
